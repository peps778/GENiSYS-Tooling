---
import icon from "../assets/genisys-icon.png";

interface Props {
    title: string;
    description?: string;
    image?: string;
    canonical?: string;
}

const {
    title,
    description = "GENiSYS Tooling cybersecurity analysis workspace.",
    image,
    canonical
} = Astro.props;

const siteUrl = Astro.site ?? new URL(
    "https://genisys-tooling.college-paulmagbanua.workers.dev"
);

const canonicalUrl = canonical
    ? new URL(canonical, siteUrl)
    : Astro.url;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>

<meta
    name="description"
    content={description}
/>

{canonicalUrl && (
    <link
        rel="canonical"
        href={canonicalUrl}
/>
)}

<!-- GENiSYS favicon -->
<link
    rel="icon"
    type="image/png"
    href={icon.src}
/>

<link
    rel="shortcut icon"
    type="image/png"
    href={icon.src}
/>

<!-- Open Graph metadata -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />

{image && (
    <meta
        property="og:image"
        content={new URL(image, siteUrl)}
    />
)}